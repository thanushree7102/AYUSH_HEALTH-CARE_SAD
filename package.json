    "test:reader": "node scripts/reader-test.js"
  },
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
