# Copy to .env (never commit .env).
AYUSH_SECRET=            # long random text; signs tokens + encrypts face templates. If empty a random one is created in data/ayush.secret
PORT_BASE=5000           # gateway = PORT_BASE, platform = +1 ... event bus = +10
OTP_CODE=                # EMPTY = random OTP per request. Set e.g. 123456 only for fixed demo/test code
OTP_SHOW=1               # 1 = demo: show OTP on screen when not delivered on WhatsApp. 0 = hide
FACE_THRESHOLD=0.5
FACE_REQUIRED=1
ADMIN_INVITE=AYUSH-ADMIN-2026
ACCESS_TOKEN_MINUTES=60
DEMO_AADHAAR_HINT=1
SEED_DEMO=1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# WhatsApp: mock (default, no real WhatsApp) | meta (needs token + phone id + webhook) | baileys | off
WHATSAPP_MODE=mock
WHATSAPP_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=ayush-verify
WHATSAPP_APP_SECRET=
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
TRANSLATE_URL=
TRANSLATE_KEY=
ANTHROPIC_API_KEY=       # Optional: enables vision OCR for handwriting / Hindi (keep private)
ANTHROPIC_MODEL=         # Optional: model name supported by your API account
